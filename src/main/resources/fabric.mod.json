{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "icon": "assets/twilightsparksdelight/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.arakiel.twilightsparksdelight.TwilightSparksDelight"
    ],
    "client": [
      "dev.arakiel.twilightsparksdelight.client.TSDClientSetup"
    ],
    "jei_mod_plugin": [
      "dev.arakiel.twilightsparksdelight.client.integration.jei.TSDJeiPlugin"
    ],
    "jade": [
      "dev.arakiel.twilightsparksdelight.integration.jade.TSDJadePlugin"
    ],
    "gemini:components": [
      "dev.arakiel.twilightsparksdelight.common.data.TSDDataComponents"
    ]
  },
  "mixins": [
    "twilightsparksdelight.mixins.json",
    {
      "config": "twilightsparksdelight.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.9",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "gemini": ">=1.0.3",
    "farmersdelight": ">=1.21.1-3.3.6",
    "twilightforest": ">=4.8.629"
  },
  "suggests": {
    "jei": "*",
    "appleskin": "*",
    "jade": "*",
    "curiosfabric": ">=9.5.1",
    "twilightdelight": ">=3.2.0"
  },
  "custom": {
    "gemini:components": [
      "twilightsparksdelight:entity_data",
      "twilightsparksdelight:block_entity_data"
    ]
  }
}
