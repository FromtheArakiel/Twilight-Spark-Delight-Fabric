{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "icon": "assets/twilightsparksdelightfabric/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.arakiel.twilightsparksdelightfabric.TwilightSparksDelightFabric"
    ],
    "client": [
      "dev.arakiel.twilightsparksdelightfabric.client.TSDClientSetup"
    ],
    "jei_mod_plugin": [
      "dev.arakiel.twilightsparksdelightfabric.client.integration.jei.TSDJeiPlugin"
    ]
  },
  "mixins": [
    "twilightsparksdelightfabric.mixins.json",
    {
      "config": "twilightsparksdelightfabric.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.9",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "farmersdelight": ">=1.21.1-3.3.6",
    "twilightforest": ">=4.8.629"
  },
  "suggests": {
    "jei": "*",
    "appleskin": "*"
  }
}
